{
	"schemaVersion": 1,
	"id": "unlimusic",
	"version": "${version}",
	"name": "UnliMusic",
	"description": "Listen to music in-game, on your own or in sync with every player: local files, Creative Commons music from Jamendo and online radio stations.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/unlimusic/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.unlimusic.UnliMusic"
		],
		"client": [
			"com.unlimusic.client.UnliMusicClient"
		]
	},
	"mixins": [
		"unlimusic.mixins.json",
		{
			"config": "unlimusic.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}